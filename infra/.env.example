# ===================================================
# CredChain environment variables (TEMPLATE)
# Copy this file to ".env" and put real values there.
# NEVER put real passwords in this file.
# ===================================================

# ---------- PostgreSQL ----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=credchain
DB_USERNAME=credchain
DB_PASSWORD=changeme

# ---------- JWT (Phase 1) ----------
# ---------- JWT (Phase 1) ----------
# Generate: $b = New-Object byte[] 64; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=replace-with-generated-base64-key
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---------- Redis (Phase 4) ----------
REDIS_HOST=localhost
REDIS_PORT=6379

# ---------- RabbitMQ (Phase 4) ----------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=credchain
RABBITMQ_PASSWORD=changeme

# ---------- MinIO / file storage (Phase 4) ----------
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=credchain
MINIO_ROOT_PASSWORD=changeme123
MINIO_BUCKET=certificates

# ---------- Blockchain (Phase 3) ----------
BLOCKCHAIN_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your-api-key
BLOCKCHAIN_PRIVATE_KEY=your-wallet-private-key
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000


# ---------- Bootstrap super admin (created once on first startup) ----------
SUPER_ADMIN_EMAIL=admin@credchain.dev
SUPER_ADMIN_PASSWORD=replace-with-strong-password-min-12-chars
SUPER_ADMIN_FULL_NAME=System Administrator


# ---------- CORS (required in prod) ----------
# Comma-separated list of frontend URLs allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173