# ===================================================
# CredChain settings (TEMPLATE)
# Copy this file to ".env" in the same folder and put the real values there.
# .env is git-ignored: never commit it. NEVER put real passwords or keys in this file.
# The backend reads infra/.env when it starts; docker compose reads it too.
# ===================================================

# ---------- PostgreSQL ----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=credchain
DB_USERNAME=credchain
DB_PASSWORD=replace-with-a-database-password

# ---------- Logins (JWT) ----------
# Generate in PowerShell: $b = New-Object byte[] 64; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=replace-with-generated-base64-key
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---------- Super admin (created once, on the first start with an empty database) ----------
SUPER_ADMIN_EMAIL=admin@credchain.dev
SUPER_ADMIN_PASSWORD=replace-with-strong-password-min-12-chars
SUPER_ADMIN_FULL_NAME=System Administrator

# ---------- Which websites may call the API from a browser ----------
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------- Blockchain (Sepolia) ----------
BLOCKCHAIN_ENABLED=false
# Secret: the Alchemy URL contains your API key
BLOCKCHAIN_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your-api-key
# Secret: the platform admin wallet (pays for activating college wallets)
BLOCKCHAIN_ADMIN_PRIVATE_KEY=0xyour-admin-wallet-private-key
# Secret: AES-256 key that encrypts every college wallet. Generate like JWT_SECRET but with 32 bytes instead of 64.
# Never change it once colleges exist: their wallets could no longer be opened.
WALLET_ENCRYPTION_KEY=base64-encoded-32-byte-key

# ---------- File storage for certificate PDFs (RustFS in docker compose) ----------
S3_ACCESS_KEY=credchain
S3_SECRET_KEY=replace-with-a-password-min-8-chars

# ---------- AI fraud-detection service ----------
# Shared key the backend sends to the service; set one before putting the app online
FRAUD_API_KEY=

# ---------- Email ----------
# Locally every email goes to Mailpit (http://localhost:8025); nothing needs to be set.
# For a real mail server set MAIL_HOST, MAIL_PORT, MAIL_USERNAME, MAIL_PASSWORD, MAIL_SMTP_AUTH=true, MAIL_STARTTLS=true.
MAIL_ENABLED=true
MAIL_FROM=CredChain <no-reply@credchain.local>

# ---------- Links (backend in IntelliJ + website with npm run dev) ----------
# QR codes, share links and links in emails point here
VERIFICATION_BASE_URL=http://localhost:5173/verify
SHARE_BASE_URL=http://localhost:5173/s
WEB_BASE_URL=http://localhost:5173

# ---------- Whole app in Docker (docker compose --profile app up -d --build) ----------
# The address people open the website on. QR codes, share links and emails use it, and it replaces the
# three links above inside Docker. In the cloud: https://your-domain
PUBLIC_URL=http://localhost:8088
WEB_PORT=8088

# ---------- Online on a cloud server (docker compose --profile app --profile cloud, see infra/DEPLOY.md) ----------
# The web address, e.g. 20-198-5-17.sslip.io; Caddy gets its HTTPS certificate. Also set
# PUBLIC_URL=https://<that address> and WEB_PORT=127.0.0.1:8088 there.
DOMAIN=
