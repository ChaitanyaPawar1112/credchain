# ===================================================
# CredChain environment variables (TEMPLATE)
# Copy this file to ".env" and put real values there.
# NEVER put real passwords in this file.
# ===================================================

# ---------- PostgreSQL ----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=credchain
DB_USERNAME=credchain
DB_PASSWORD=changeme

# ---------- JWT (Phase 1) ----------
JWT_SECRET=replace-with-a-long-random-base64-string
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# ---------- Redis (Phase 4) ----------
REDIS_HOST=localhost
REDIS_PORT=6379

# ---------- RabbitMQ (Phase 4) ----------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=credchain
RABBITMQ_PASSWORD=changeme

# ---------- MinIO / file storage (Phase 4) ----------
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=credchain
MINIO_ROOT_PASSWORD=changeme123
MINIO_BUCKET=certificates

# ---------- Blockchain (Phase 3) ----------
BLOCKCHAIN_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your-api-key
BLOCKCHAIN_PRIVATE_KEY=your-wallet-private-key
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000