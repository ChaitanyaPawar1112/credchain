# ===================================================
# CredChain environment variables (TEMPLATE)
# Copy this file to ".env" and put real values there.
# NEVER put real passwords in this file.
# ===================================================

# ---------- PostgreSQL ----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=credchain
DB_USERNAME=credchain
DB_PASSWORD=changeme

# ---------- JWT (Phase 1) ----------
# ---------- JWT (Phase 1) ----------
# Generate: $b = New-Object byte[] 64; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=replace-with-generated-base64-key
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---------- Redis (Phase 4) ----------
REDIS_HOST=localhost
REDIS_PORT=6379

# ---------- RabbitMQ (Phase 4) ----------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=credchain
RABBITMQ_PASSWORD=changeme

# ---------- MinIO / file storage (Phase 4) ----------
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=credchain
MINIO_ROOT_PASSWORD=changeme123
MINIO_BUCKET=certificates

# ---------- Blockchain (Phase 3) ----------
BLOCKCHAIN_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your-api-key
BLOCKCHAIN_PRIVATE_KEY=your-wallet-private-key
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000


# ---------- Bootstrap super admin (created once on first startup) ----------
SUPER_ADMIN_EMAIL=admin@credchain.dev
SUPER_ADMIN_PASSWORD=replace-with-strong-password-min-12-chars
SUPER_ADMIN_FULL_NAME=System Administrator


# ---------- CORS (required in prod) ----------
# Comma-separated list of frontend URLs allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173

# -# ---------- Blockchain (Phase 4) ----------
   BLOCKCHAIN_ENABLED=false
   BLOCKCHAIN_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your-api-key
   BLOCKCHAIN_ADMIN_PRIVATE_KEY=0xyour-admin-wallet-private-key

WALLET_ENCRYPTION_KEY=base64-encoded-32-byte-key

# ---------- Object storage for certificate PDFs (Phase 4.9, RustFS in Docker) ----------
# Used by both docker-compose (container login) and the backend (S3 client)
S3_ACCESS_KEY=credchain
S3_SECRET_KEY=replace-with-a-password-min-8-chars
# ---------- Email (Phase 8.2) ----------
# Defaults send to Mailpit in docker compose (read at http://localhost:8025); nothing needs to be set locally.
# For a real mail server set MAIL_HOST, MAIL_PORT, MAIL_USERNAME, MAIL_PASSWORD, MAIL_SMTP_AUTH=true, MAIL_STARTTLS=true.
MAIL_ENABLED=true
MAIL_FROM=CredChain <no-reply@credchain.local>
WEB_BASE_URL=http://localhost:5173

# ---------- Share links (Phase 8.4) ----------
# Students' share links open {SHARE_BASE_URL}/{token}; set it to the public website address in production
SHARE_BASE_URL=http://localhost:5173/s

# ---------- Whole app in Docker (Phase 9.1: docker compose --profile app up -d --build) ----------
# Address people open the website on; QR codes, share links and emails use it. In the cloud: https://your-domain
PUBLIC_URL=http://localhost:8088
WEB_PORT=8088
